<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
<servlet>
    <servlet-name>AddProduct</servlet-name>
    <servlet-class>AddProductServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>AddProduct</servlet-name>
    <url-pattern>/AddProductServlet</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>ViewProduct</servlet-name>
    <servlet-class>ViewProductsServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>ViewProduct</servlet-name>
    <url-pattern>/ViewProductsServlet</url-pattern>
</servlet-mapping>
  
</web-app>