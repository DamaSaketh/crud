<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

<servlet>
    <servlet-name>AddEmployeeServlet</servlet-name>
    <servlet-class>com.emp.servlet.AddEmployeeServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>AddEmployeeServlet</servlet-name>
    <url-pattern>/add</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>ListEmployeeServlet</servlet-name>
    <servlet-class>com.emp.servlet.ListEmployeeServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>ListEmployeeServlet</servlet-name>
    <url-pattern>/list</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>DeleteEmployeeServlet</servlet-name>
    <servlet-class>com.emp.servlet.DeleteEmployeeServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>DeleteEmployeeServlet</servlet-name>
    <url-pattern>/delete</url-pattern>
</servlet-mapping>

</web-app>